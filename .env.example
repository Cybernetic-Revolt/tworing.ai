# tworing platform — environment variable NAMES only. No real values, ever.
#
# ⚠️ INCOMPLETE BY CONSTRUCTION. The names below are the ones confirmed by the
# Phase 0 audit of CT 129 plus the integrations the schema implies. The real
# /opt/bilco-platform/.env almost certainly has more. Step 1 of the import is to
# diff this file against the live one and add every missing NAME (never a value).

# --- core ---
DATABASE_URL=postgresql://user:password@host:5432/bilco_platform
NEXTAUTH_URL=https://tworing.ai
NEXTAUTH_SECRET=

# --- telephony ---
# VoIP.ms is the carrier of record; routing strings point DIDs at SIP subaccounts.
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
# Secondary carrier for new DIDs.
TELNYX_API_KEY=

# --- voice engine ---
# Vapi is being replaced by switchboard; both may be set during cutover.
VAPI_API_KEY=
SWITCHBOARD_BASE_URL=
SWITCHBOARD_API_KEY=

# --- AI providers ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# --- billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- integrations ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# --- storage (AWS, ca-west-1) ---
AWS_REGION=ca-west-1
S3_RECORDINGS_BUCKET=
S3_RECORDINGS_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
