# Copy to .env for local dev (docker compose up -d db).
#
# NAMES ONLY — never commit a value. On the CT 129 host the real file lives at
# /etc/bilco-platform.env (chmod 600) and .env is a symlink to it.
# This list was taken from the live environment on 2026-08-25 and is complete
# as of that date.

# --- core ---
DATABASE_URL="postgresql://bilco:bilco@localhost:5433/bilco_platform"
# Public base URL of this app — used for the voice engine's server webhooks.
PLATFORM_URL="https://platform.bilco.ca"
# Session cookie signing secret (openssl rand -hex 32).
SESSION_SECRET=""
# Encrypts stored third-party OAuth tokens at rest. Rotating it invalidates
# every stored Google/Jobber connection, forcing each client to re-consent.
TOKEN_ENCRYPTION_KEY=""

# --- voice engine ---
# Vapi (dashboard.vapi.ai -> Organization -> API Keys). Being replaced by switchboard.
VAPI_API_KEY=""

# --- voice providers (populate the admin voice picker) ---
# ElevenLabs (https://elevenlabs.io/app/settings/api-keys). Same key the voice engine uses.
ELEVENLABS_API_KEY=""
# Cartesia (https://play.cartesia.ai/keys). Stored only; the engine does not build Cartesia
# TTS yet, so a Cartesia voice is config-only until that adapter ships.
CARTESIA_API_KEY=""

# --- telephony (VoIP.ms REST API: enable + whitelist the caller IP at voip.ms) ---
VOIPMS_API_USERNAME=""
VOIPMS_API_PASSWORD=""
# Shared secret authenticating inbound SMS webhooks.
SMS_INBOUND_SECRET=""

# --- billing (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ANSWER=""
STRIPE_PRICE_OFFICE=""
STRIPE_PRICE_OPERATIONS=""
STRIPE_PRICE_EXTRA_NUMBER=""
STRIPE_PRICE_OVERAGE=""

# --- integrations ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
JOBBER_CLIENT_ID=""
JOBBER_CLIENT_SECRET=""

# --- outbound mail (Resend) ---
RESEND_API_KEY=""
MAIL_FROM_DOMAIN=""
MAIL_DOMAIN_VERIFIED=""
