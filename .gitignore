# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated client (regenerated on install)
/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- added with the AWS move ---
# Runtime data belongs in S3, never in the repo.
uploads/
# Anchored to the repo root. Unanchored, this matched src/app/api/recordings/ and silently
# excluded the route that serves call audio — `git add -A` skipped it without a word, the
# commit and the local build both succeeded, and the deployed box simply never had the file.
# A play button that did nothing was the only symptom.
/recordings/
public/recordings/
# Additional key material beyond *.pem.
*.key
*.p12
*.pfx
# Local database artifacts.
prisma/*.db
prisma/*.db-journal
# Amplify local build state.
.amplify-hosting/
# Editors / coverage.
.vscode/
.idea/
coverage/
